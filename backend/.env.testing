APP_NAME="Sales CRM"
APP_ENV=testing
APP_KEY=base64:zDy0WyNjR36Ube8sZHH5XI8s3KBhvAfiky4rykfVIAU=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Tests run against a dedicated MySQL schema (NOT SQLite) so FOR UPDATE
# row locks and CHECK constraints have production fidelity.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sales_crm_testing
DB_USERNAME=sales
DB_PASSWORD=secret

# No external side effects in the automated suite; individual tests use fakes.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log

# Faster hashing in tests.
BCRYPT_ROUNDS=4

CRM_LOST_THRESHOLD_DAYS=90
CRM_TAX_RATE=0.05
CRM_KPI_RECOVERY_POINTS=10
CRM_STORE_CACHE_TTL=300
