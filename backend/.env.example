APP_NAME="Sales CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (Docker service name) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sales_crm
DB_USERNAME=sales
DB_PASSWORD=secret

# ---- Sessions / Sanctum SPA cookie auth -------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# ---- Redis (Docker service name) --------------------------------------
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail: Mailpit sink (default, self-contained) ---------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@salescrm.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Mail: real Mailtrap (uncomment + drop the mailpit service to use)-
# MAIL_SCHEME=tls
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<your-mailtrap-user>
# MAIL_PASSWORD=<your-mailtrap-pass>

# ---- Vonage / SMS (re-engagement channel; log-only unless configured) -
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM="Sales CRM"

# ---- CRM domain configuration (overridable at runtime via settings) ---
CRM_LOST_THRESHOLD_DAYS=90
CRM_TAX_RATE=0.05
CRM_KPI_RECOVERY_POINTS=10
CRM_STORE_CACHE_TTL=300

VITE_APP_NAME="${APP_NAME}"
